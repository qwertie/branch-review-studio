{
  "name": "branch-review-studio",
  "displayName": "Branch Review Studio",
  "description": "Review a branch's working tree against its merge-base with develop, with comment threads exchanged with AI agents (Claude Code, Codex or VS Code's chat).",
  "version": "0.8.0",
  "publisher": "qwertie",
  "private": true,
  "license": "Unlicense",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/qwertie/branch-review-studio.git"
  },
  "homepage": "https://github.com/qwertie/branch-review-studio#readme",
  "bugs": {
    "url": "https://github.com/qwertie/branch-review-studio/issues"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "branchReviewStudio.mcpServer",
        "label": "Branch Review Studio"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/branch-review-studio/SKILL.md",
        "sessionTypes": [
          "local"
        ]
      }
    ],
    "chatAgents": [
      {
        "path": "./agents/branch-reviewer.agent.md",
        "sessionTypes": [
          "local"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchReviewStudio",
          "title": "Branch Review",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "branchReviewStudio": [
        {
          "type": "webview",
          "id": "branchReviewStudio.files",
          "name": "Branch Review"
        }
      ]
    },
    "commands": [
      {
        "command": "branchReviewStudio.refresh",
        "title": "Refresh",
        "category": "Branch Review Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "branchReviewStudio.openAllChanges",
        "title": "Open All Changes",
        "category": "Branch Review Studio",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "branchReviewStudio.openGroupChanges",
        "title": "Open Group Changes",
        "category": "Branch Review Studio",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "branchReviewStudio.openFileDiff",
        "title": "Open File Diff",
        "category": "Branch Review Studio",
        "icon": "$(diff)"
      },
      {
        "command": "branchReviewStudio.openThread",
        "title": "Go to Thread…",
        "category": "Branch Review Studio",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "branchReviewStudio.previousThread",
        "title": "Previous Thread",
        "category": "Branch Review Studio",
        "icon": "$(chevron-up)"
      },
      {
        "command": "branchReviewStudio.nextThread",
        "title": "Next Thread",
        "category": "Branch Review Studio",
        "icon": "$(chevron-down)"
      },
      {
        "command": "branchReviewStudio.previousUnresolvedThread",
        "title": "Previous Unresolved Thread",
        "category": "Branch Review Studio",
        "icon": "$(arrow-circle-up)"
      },
      {
        "command": "branchReviewStudio.nextUnresolvedThread",
        "title": "Next Unresolved Thread",
        "category": "Branch Review Studio",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "branchReviewStudio.switchBranch",
        "title": "Switch Branch…",
        "category": "Branch Review Studio",
        "icon": "$(git-branch)"
      },
      {
        "command": "branchReviewStudio.changeBaseBranch",
        "title": "Change Base Branch…",
        "category": "Branch Review Studio",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "branchReviewStudio.fetchBase",
        "title": "Fetch Base Branch",
        "category": "Branch Review Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "branchReviewStudio.createThread",
        "title": "Add Comment",
        "category": "Branch Review Studio"
      },
      {
        "command": "branchReviewStudio.reply",
        "title": "Reply",
        "category": "Branch Review Studio"
      },
      {
        "command": "branchReviewStudio.resolveThread",
        "title": "Resolve",
        "category": "Branch Review Studio",
        "icon": "$(check)"
      },
      {
        "command": "branchReviewStudio.unresolveThread",
        "title": "Reopen",
        "category": "Branch Review Studio",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "branchReviewStudio.deleteThread",
        "title": "Delete Thread",
        "category": "Branch Review Studio",
        "icon": "$(trash)"
      },
      {
        "command": "branchReviewStudio.askAgent",
        "title": "Ask Agent",
        "category": "Branch Review Studio",
        "icon": "$(sparkle)"
      },
      {
        "command": "branchReviewStudio.openSettings",
        "title": "Settings and Integrations",
        "category": "Branch Review Studio",
        "icon": "$(gear)"
      },
      {
        "command": "branchReviewStudio.installMcpServer",
        "title": "Install MCP Server and Skill (Claude Code, Codex)",
        "category": "Branch Review Studio"
      },
      {
        "command": "branchReviewStudio.installSkill",
        "title": "Install Skill (Claude Code, Codex)",
        "category": "Branch Review Studio"
      },
      {
        "command": "branchReviewStudio.uninstall",
        "title": "Uninstall MCP Server and Skills",
        "category": "Branch Review Studio"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchReviewStudio.fetchBase",
          "when": "view == branchReviewStudio.files",
          "group": "1_base"
        }
      ],
      "editor/title": [
        {
          "command": "branchReviewStudio.previousThread",
          "when": "branchReviewStudio.hasThreads",
          "group": "navigation@1"
        },
        {
          "command": "branchReviewStudio.nextThread",
          "when": "branchReviewStudio.hasThreads",
          "group": "navigation@2"
        },
        {
          "command": "branchReviewStudio.previousUnresolvedThread",
          "when": "branchReviewStudio.hasThreads",
          "group": "navigation@3"
        },
        {
          "command": "branchReviewStudio.nextUnresolvedThread",
          "when": "branchReviewStudio.hasThreads",
          "group": "navigation@4"
        },
        {
          "command": "branchReviewStudio.openThread",
          "when": "branchReviewStudio.hasThreads",
          "group": "navigation@5"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "branchReviewStudio.createThread",
          "when": "commentController == branch-review-studio && commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "branchReviewStudio.reply",
          "when": "commentController == branch-review-studio && !commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "branchReviewStudio.askAgent",
          "when": "commentController == branch-review-studio",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "branchReviewStudio.resolveThread",
          "when": "commentController == branch-review-studio && commentThread == brsOpen",
          "group": "inline@1"
        },
        {
          "command": "branchReviewStudio.unresolveThread",
          "when": "commentController == branch-review-studio && commentThread == brsResolved",
          "group": "inline@1"
        },
        {
          "command": "branchReviewStudio.deleteThread",
          "when": "commentController == branch-review-studio && commentThread =~ /^brs(Open|Resolved)$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "branchReviewStudio.openGroupChanges",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.openFileDiff",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.createThread",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.reply",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.resolveThread",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.unresolveThread",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.deleteThread",
          "when": "false"
        },
        {
          "command": "branchReviewStudio.askAgent",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Branch Review Studio",
      "properties": {
        "branchReviewStudio.baseBranch": {
          "type": "string",
          "default": "develop",
          "description": "Branch to compare against when the current branch has no review yet; a review keeps the base branch it was created with until you run Change Base Branch…. The diff base is `git merge-base origin/<baseBranch> HEAD` if origin/<baseBranch> exists, else `git merge-base <baseBranch> HEAD`."
        },
        "branchReviewStudio.openWorktreeInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "Whether Switch Branch opens the branch's worktree in a new window instead of the current one."
        },
        "branchReviewStudio.worktreeRoot": {
          "type": "string",
          "default": "",
          "description": "Folder in which Switch Branch creates new worktrees. Empty means a sibling folder of the main worktree named `<repoName>.worktrees`."
        },
        "branchReviewStudio.claudePath": {
          "type": "string",
          "default": "",
          "description": "Path of the Claude Code CLI (claude.exe or claude). Empty means search PATH, then ~/.local/bin."
        },
        "branchReviewStudio.codexPath": {
          "type": "string",
          "default": "",
          "description": "Path of the Codex CLI (codex.exe or codex). Empty means the CLI bundled with the OpenAI Codex VS Code extension (openai.chatgpt) if it is installed, else codex on PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies",
    "sample-review": "esbuild scripts/create-sample-review.ts --bundle --platform=node --format=cjs --outfile=out/create-sample-review.js && node out/create-sample-review.js",
    "smoke-test": "node scripts/run-smoke-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  }
}
